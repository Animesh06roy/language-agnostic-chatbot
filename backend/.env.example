# ─── Language Agnostic AI Chatbot — Backend Environment Variables ───────────
# Copy this to .env and fill in your values.
# The app works with defaults — no changes needed for localhost.

# Django settings
DJANGO_SETTINGS_MODULE=language_agnostic_chatbot.settings
SECRET_KEY=django-insecure-change-this-in-production

# Rasa NLU server (running on port 5005 by default)
RASA_SERVER_URL=http://localhost:5005

# Debug mode (set to False in production)
DEBUG=True

# Comma-separated hostnames Django will serve (add your domain in production)
ALLOWED_HOSTS=localhost,127.0.0.1
